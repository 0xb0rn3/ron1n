#!/usr/bin/env bash
set -Eeuo pipefail

# Source-tree compatibility launcher. Installed users run the native Go binary
# delivered by install.sh/install.ps1; this wrapper keeps legacy `./ron1n`
# workflows and Bash automation working without retaining the Bash runtime.

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

for candidate in \
    "${source_dir}/build/ron1n" \
    "${source_dir}/dist/0.0.1zoro/ron1n-linux-amd64" \
    "${source_dir}/dist/0.0.1zoro/ron1n-linux-arm64" \
    "${source_dir}/dist/0.0.1zoro/ron1n-darwin-amd64" \
    "${source_dir}/dist/0.0.1zoro/ron1n-darwin-arm64"; do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

if command -v go >/dev/null 2>&1; then
    cd -- "$source_dir"
    exec go run ./cmd/ron1n "$@"
fi

printf 'ron1n: no native binary or Go toolchain found.\n' >&2
printf 'Install a verified release with install.sh or install.ps1; see README.md.\n' >&2
exit 1

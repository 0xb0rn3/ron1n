#!/usr/bin/env bash
set -Eeuo pipefail

RON1N_VERSION="1.3.0"
APP="ron1n"

REPO_URL="${RON1N_REPO_URL:-https://github.com/kmeps4/PSFree.git}"
PORT="${RON1N_PORT:-8080}"
SCAN_INTERVAL="${RON1N_SCAN_INTERVAL:-3}"
RECENT_HTTP_SECONDS="${RON1N_RECENT_HTTP_SECONDS:-30}"

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/${APP}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/${APP}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${APP}"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

HOST_DIR="${DATA_DIR}/PSFree"
SERVER_PY="${DATA_DIR}/ron1n-server.py"

SERVICE="${APP}.service"
SERVICE_FILE="${SYSTEMD_DIR}/${SERVICE}"

PS4_IP_FILE="${STATE_DIR}/ps4.ip"
PS4_MAC_FILE="${STATE_DIR}/ps4.mac"
CONSOLE_STATE="${STATE_DIR}/console.json"
EVENT_LOG="${STATE_DIR}/events.log"
PKG_LOG="${STATE_DIR}/packages.log"

mkdir -p "$DATA_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SYSTEMD_DIR"

BOLD='\033[1m'
DIM='\033[2m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
RESET='\033[0m'

say()  { printf "%b\n" "$*"; }
info() { say "${BLUE}[+]${RESET} $*"; }
ok()   { say "${GREEN}[✓]${RESET} $*"; }
warn() { say "${YELLOW}[!]${RESET} $*"; }
err()  { say "${RED}[x]${RESET} $*" >&2; }
die()  { err "$*"; exit 1; }

banner() {
    printf "\n"
    say "${MAGENTA}${BOLD}╭──────────────────────────────────────────────╮${RESET}"
    say "${MAGENTA}${BOLD}│                    ron1n                     │${RESET}"
    say "${MAGENTA}${BOLD}│      PS4 9.00 Local Jailbreak Host          │${RESET}"
    say "${MAGENTA}${BOLD}╰──────────────────────────────────────────────╯${RESET}"
    say "${DIM}Built by 0xb0rn3 / Stingray Labs · v${RON1N_VERSION}${RESET}"
    printf "\n"
}

have() { command -v "$1" >/dev/null 2>&1; }

install_dependencies() {
    local pkgs=(git python iproute2 iputils curl nmap arp-scan)
    info "Setting up ron1n..."
    sudo -v

    if sudo pacman -S --needed --noconfirm "${pkgs[@]}" >"$PKG_LOG" 2>&1; then
        ok "System dependencies ready."
    else
        err "Dependency setup failed."
        cat "$PKG_LOG" >&2
        exit 1
    fi
}

detect_network() {
    IFACE="$(
        ip -4 route show default 2>/dev/null |
        awk 'NR==1 {
            for(i=1;i<=NF;i++) {
                if($i=="dev") {print $(i+1); exit}
            }
        }'
    )"
    [[ -n "${IFACE:-}" ]] || die "No active IPv4 interface found."

    LAN_IP="$(
        ip -4 addr show dev "$IFACE" |
        awk '/inet / {split($2,a,"/"); print a[1]; exit}'
    )"
    [[ -n "${LAN_IP:-}" ]] || die "No IPv4 address on ${IFACE}."

    CIDR="$(
        ip -4 route show dev "$IFACE" |
        awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ && /scope link/ {
            print $1; exit
        }'
    )"

    ok "Interface : ${IFACE}"
    ok "LAN IP    : ${LAN_IP}"
    ok "Network   : ${CIDR}"
}

install_server() {
    local source_dir
    source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

    [[ -f "${source_dir}/ron1n-server.py" ]] ||
        die "ron1n-server.py is missing next to the ron1n executable."

    install -m 0755 "${source_dir}/ron1n-server.py" "$SERVER_PY"
    ok "Browser-aware detection engine ready."
}

validate_host() {
    local required=(index.html cache.html psfree.mjs lapse.mjs psfree_lapse.cache goldhen.bin)
    local missing=0

    for file in "${required[@]}"; do
        if [[ -f "${HOST_DIR}/${file}" ]]; then
            ok "$file"
        else
            err "Missing: $file"
            missing=1
        fi
    done

    (( missing == 0 )) || die "PSFree/Lapse host is incomplete."
}

install_host() {
    if [[ -d "${HOST_DIR}/.git" ]]; then
        info "Checking PSFree/Lapse host..."
        if git -C "$HOST_DIR" pull --ff-only >/dev/null 2>&1; then
            ok "PSFree/Lapse host is up to date."
        else
            warn "Upstream update failed; using existing local host."
        fi
    else
        info "Fetching PSFree/Lapse host..."
        rm -rf "$HOST_DIR"
        git clone --depth=1 "$REPO_URL" "$HOST_DIR" >/dev/null 2>&1 ||
            die "Could not fetch PSFree/Lapse."
        ok "PSFree/Lapse downloaded."
    fi

    validate_host
}

legacy_cleanup() {
    local legacy
    for legacy in ps4-900-host.service ps4-jailbreak-host.service; do
        if systemctl --user cat "$legacy" >/dev/null 2>&1; then
            warn "Legacy host detected: ${legacy}"
            systemctl --user disable --now "$legacy" >/dev/null 2>&1 || true
            ok "Disabled legacy service."
        fi
    done
    systemctl --user daemon-reload
}

write_service() {
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=ron1n - PS4 9.00 Local Jailbreak Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HOST_DIR}
ExecStart=/usr/bin/python ${SERVER_PY} --port ${PORT} --bind 0.0.0.0 --directory ${HOST_DIR} --state-dir ${STATE_DIR}
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE" >/dev/null 2>&1 || true
    sudo loginctl enable-linger "$USER" >/dev/null 2>&1 || true
}

port_owner() {
    ss -ltnp 2>/dev/null | awk -v p=":${PORT}" '$4 ~ p"$" {print; exit}'
}

start_service() {
    legacy_cleanup
    systemctl --user stop "$SERVICE" >/dev/null 2>&1 || true
    sleep .3

    local owner
    owner="$(port_owner || true)"
    if [[ -n "$owner" ]]; then
        err "TCP/${PORT} is already in use:"
        say "  ${owner}"
        die "Free the port or set RON1N_PORT to another value."
    fi

    info "Starting ron1n host..."
    systemctl --user start "$SERVICE"
    sleep 1

    if ! systemctl --user is-active --quiet "$SERVICE"; then
        err "ron1n service failed."
        journalctl --user -u "$SERVICE" -n 20 --no-pager || true
        exit 1
    fi

    ok "ron1n host service is running."
}

configure_firewall() {
    if have firewall-cmd; then
        info "Configuring local firewall..."
        sudo firewall-cmd --permanent --add-port="${PORT}/tcp" >/dev/null 2>&1 || true
        sudo firewall-cmd --reload >/dev/null 2>&1 || true
        ok "TCP ${PORT} available on the LAN."
    elif have ufw; then
        info "Configuring local firewall..."
        sudo ufw allow "${PORT}/tcp" >/dev/null 2>&1 || true
        ok "TCP ${PORT} available on the LAN."
    fi
}

health_check() {
    curl --silent --fail "http://127.0.0.1:${PORT}/_ron1n/status" >/dev/null ||
        die "ron1n HTTP health check failed."
    ok "Web host health check passed."
}

# ----------------------------------------------------------------
# Strong detection: HTTP User-Agent/state produced by ron1n-server
# ----------------------------------------------------------------

console_state_field() {
    local field="$1"
    [[ -s "$CONSOLE_STATE" ]] || return 1

    python - "$CONSOLE_STATE" "$field" <<'PY'
import json, sys
p, field = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(p))
    value = data.get(field, "")
    if isinstance(value, bool):
        print("true" if value else "false")
    else:
        print(value)
except Exception:
    pass
PY
}

console_recent() {
    [[ -s "$CONSOLE_STATE" ]] || return 1
    local ts now
    ts="$(console_state_field ts || true)"
    [[ "$ts" =~ ^[0-9]+$ ]] || return 1
    now="$(date +%s)"
    (( now - ts <= RECENT_HTTP_SECONDS ))
}

learn_mac_from_ip() {
    local ip="$1"
    local mac=""

    # Populate neighbor cache if possible.
    ping -c1 -W1 "$ip" >/dev/null 2>&1 || true

    mac="$(ip neigh show "$ip" 2>/dev/null | awk '/lladdr/ {print $5; exit}')"
    if [[ -n "$mac" ]]; then
        printf '%s\n' "$mac" > "$PS4_MAC_FILE"
    fi
}

detect_via_http() {
    [[ -s "$CONSOLE_STATE" ]] || return 1

    local ip is_ps4
    ip="$(console_state_field ip || true)"
    is_ps4="$(console_state_field is_ps4 || true)"

    if [[ "$is_ps4" == "true" && -n "$ip" ]]; then
        printf '%s\n' "$ip" > "$PS4_IP_FILE"
        learn_mac_from_ip "$ip"
        printf '%s\n' "$ip"
        return 0
    fi

    return 1
}

# ----------------------------------------------------------------
# Fallback detection
# ----------------------------------------------------------------

arp_scan_raw() {
    sudo arp-scan --interface="$IFACE" --localnet 2>/dev/null || true
}

discover_by_saved_mac() {
    [[ -s "$PS4_MAC_FILE" ]] || return 1
    local wanted
    wanted="$(tr '[:upper:]' '[:lower:]' < "$PS4_MAC_FILE")"

    arp_scan_raw |
    awk -v wanted="$wanted" '
        /^[0-9]+\./ {
            mac=tolower($2)
            if(mac == wanted) {print $1; exit}
        }
    '
}

discover_sony() {
    arp_scan_raw |
    awk '
        /^[0-9]+\./ {
            line=tolower($0)
            if(line ~ /sony/ || line ~ /playstation/) {
                print $1; exit
            }
        }
    '
}

detect_ps4_once() {
    detect_network >/dev/null

    local ip=""

    # 1. Strongest signal: actual PS4 browser request.
    if ip="$(detect_via_http 2>/dev/null)" && [[ -n "$ip" ]]; then
        printf '%s\n' "$ip"
        return 0
    fi

    # 2. Previously learned MAC.
    if ip="$(discover_by_saved_mac 2>/dev/null)" && [[ -n "$ip" ]]; then
        printf '%s\n' "$ip" > "$PS4_IP_FILE"
        printf '%s\n' "$ip"
        return 0
    fi

    # 3. Sony/PlayStation vendor scan.
    if ip="$(discover_sony 2>/dev/null)" && [[ -n "$ip" ]]; then
        printf '%s\n' "$ip" > "$PS4_IP_FILE"
        learn_mac_from_ip "$ip"
        printf '%s\n' "$ip"
        return 0
    fi

    return 1
}

stage_text() {
    local stage
    stage="$(console_state_field stage || true)"
    case "$stage" in
        offline-cache)            echo "Offline cache requested" ;;
        browser)                  echo "PS4 browser connected" ;;
        webkit-exploit-activity)  echo "PSFree activity detected" ;;
        kernel-exploit-activity)  echo "Lapse activity detected" ;;
        goldhen-payload-served)   echo "GoldHEN payload served" ;;
        *)                        echo "PS4 HTTP activity detected" ;;
    esac
}

show_live_console_state() {
    [[ -s "$CONSOLE_STATE" ]] || return 0

    local ip stage path ts age now
    ip="$(console_state_field ip || true)"
    stage="$(stage_text)"
    path="$(console_state_field path || true)"
    ts="$(console_state_field ts || true)"
    now="$(date +%s)"

    if [[ "$ts" =~ ^[0-9]+$ ]]; then
        age=$((now-ts))
    else
        age="?"
    fi

    printf "\n"
    ok "PS4 browser detected: ${ip}"
    say "  State : ${CYAN}${stage}${RESET}"
    say "  Path  : ${path}"
    say "  Seen  : ${age}s ago"

    if [[ "$(console_state_field stage || true)" == "goldhen-payload-served" ]]; then
        say "  ${GREEN}${BOLD}GoldHEN payload was delivered to the console.${RESET}"
        say "  ${DIM}ron1n can confirm delivery, not successful execution inside the PS4 kernel.${RESET}"
    fi
}

ps4_connection_help() {
    detect_network >/dev/null
    printf "\n"
    say "${CYAN}${BOLD}Connect the PS4 to ron1n${RESET}"
    printf "\n"
    say "  ${BOLD}PS4 → Settings → Network → Set Up Internet Connection${RESET}"
    say "  • Use Wi-Fi or LAN"
    say "  • Same router/LAN as this Arch machine"
    say "  • Choose Easy"
    printf "\n"
    say "  Host : ${CYAN}http://${LAN_IP}:${PORT}/${RESET}"
    printf "\n"
    say "${DIM}Best detection happens automatically when the PS4 browser opens this host.${RESET}"
}

show_urls() {
    local ip="${1:-}"
    detect_network >/dev/null

    printf "\n"
    say "${GREEN}${BOLD}ron1n is ready.${RESET}"
    say "Host          : ${CYAN}http://${LAN_IP}:${PORT}/${RESET}"
    say "Offline cache : ${CYAN}http://${LAN_IP}:${PORT}/cache.html${RESET}"
    [[ -n "$ip" ]] && say "PS4           : ${GREEN}${ip}${RESET}"

    printf "\n"
    say "${BOLD}On PS4:${RESET}"
    say "  1. Internet Browser"
    say "  2. ${CYAN}http://${LAN_IP}:${PORT}/cache.html${RESET}"
    say "  3. Let caching finish"
    say "  4. ${CYAN}http://${LAN_IP}:${PORT}/${RESET}"
    say "  5. OPTIONS → Add Bookmark → ${BOLD}★ Jailbreak${RESET}"
}

wait_for_ps4() {
    detect_network
    info "Waiting for PS4 browser/network activity..."

    local ip=""
    if ip="$(detect_ps4_once 2>/dev/null)" && [[ -n "$ip" ]]; then
        ok "PS4 detected at ${ip}"
        show_live_console_state
        show_urls "$ip"
        return 0
    fi

    ps4_connection_help
    say "${YELLOW}ron1n will keep watching.${RESET}"
    say "${DIM}HTTP fingerprint + MAC + ARP fallback · every ${SCAN_INTERVAL}s${RESET}"
    printf "\n"

    local last_stage=""
    while true; do
        if ip="$(detect_ps4_once 2>/dev/null)" && [[ -n "$ip" ]]; then
            printf "\r\033[K"
            ok "PS4 detected at ${ip}"
            show_live_console_state

            # Keep watching briefly for progression, instead of exiting immediately.
            local watch_until=$(( $(date +%s) + 20 ))
            while (( $(date +%s) < watch_until )); do
                local current_stage
                current_stage="$(console_state_field stage || true)"
                if [[ -n "$current_stage" && "$current_stage" != "$last_stage" ]]; then
                    last_stage="$current_stage"
                    printf "\r\033[K"
                    case "$current_stage" in
                        offline-cache)
                            info "PS4: offline cache activity"
                            ;;
                        browser)
                            ok "PS4 browser connected"
                            ;;
                        webkit-exploit-activity)
                            info "PS4: PSFree activity"
                            ;;
                        kernel-exploit-activity)
                            info "PS4: Lapse activity"
                            ;;
                        goldhen-payload-served)
                            ok "PS4: GoldHEN payload served"
                            ;;
                    esac
                fi
                sleep 1
            done

            show_urls "$ip"
            return 0
        fi

        printf "\r${YELLOW}[~]${RESET} Waiting for PS4 browser request...   "
        sleep "$SCAN_INTERVAL"
    done
}

status_cmd() {
    banner
    detect_network
    printf "\n"

    if systemctl --user is-active --quiet "$SERVICE"; then
        ok "ron1n.service is running."
    else
        warn "ron1n.service is not running."
    fi

    show_live_console_state

    local ip=""
    ip="$(detect_ps4_once 2>/dev/null || true)"
    if [[ -n "$ip" ]]; then
        ok "PS4 known at ${ip}"
    else
        warn "No PS4 identified yet."
    fi

    show_urls "$ip"
}

watch_cmd() {
    banner
    say "${CYAN}${BOLD}Live PS4 activity${RESET}"
    say "${DIM}Ctrl+C to exit${RESET}"
    printf "\n"

    local last=""
    while true; do
        if [[ -s "$CONSOLE_STATE" ]]; then
            local snapshot
            snapshot="$(cat "$CONSOLE_STATE" 2>/dev/null || true)"
            if [[ "$snapshot" != "$last" ]]; then
                last="$snapshot"
                printf "\033[2J\033[H"
                banner
                show_live_console_state
            fi
        fi
        sleep 1
    done
}

install_cmd() {
    banner
    install_dependencies
    printf "\n"
    detect_network
    printf "\n"
    install_server
    install_host
    printf "\n"
    write_service
    configure_firewall
    start_service
    health_check
    printf "\n"
    wait_for_ps4
}

help_cmd() {
    banner
    cat <<EOF
Usage:
  ./ron1n install    Full setup
  ./ron1n wait       Wait for console
  ./ron1n watch      Live PS4 browser/exploit activity
  ./ron1n status     Current host + PS4 state
  ./ron1n connect    Show PS4 connection instructions
  ./ron1n restart    Restart ron1n server
  ./ron1n logs       Raw HTTP/service logs
  ./ron1n update     Update upstream host

Detection order:
  1. PlayStation browser User-Agent / HTTP request
  2. Remembered PS4 MAC address
  3. Sony/PlayStation ARP vendor match
EOF
}

case "${1:-install}" in
    install)
        install_cmd ;;
    wait)
        banner; wait_for_ps4 ;;
    watch)
        watch_cmd ;;
    status)
        status_cmd ;;
    connect)
        banner; detect_network; ps4_connection_help ;;
    restart)
        banner; install_server; write_service; start_service; health_check; show_urls ;;
    logs)
        journalctl --user -u "$SERVICE" -f ;;
    update)
        banner; install_host; install_server; write_service; start_service; health_check; show_urls ;;
    help|-h|--help)
        help_cmd ;;
    *)
        err "Unknown command: $1"
        help_cmd
        exit 2 ;;
esac

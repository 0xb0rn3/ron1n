#!/usr/bin/env bash
set -Eeuo pipefail

# ================================================================
#  ron1n
#  PS4 9.00 Local Jailbreak Host Orchestrator for Arch Linux
#
#  Built by 0xb0rn3 / Stingray Labs
# ================================================================

RON1N_VERSION="1.2.0"
APP="ron1n"

REPO_URL="${RON1N_REPO_URL:-https://github.com/kmeps4/PSFree.git}"
PORT="${RON1N_PORT:-8080}"
SCAN_INTERVAL="${RON1N_SCAN_INTERVAL:-5}"

DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/${APP}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/${APP}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${APP}"
SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

HOST_DIR="${DATA_DIR}/PSFree"
SERVICE="${APP}.service"
SERVICE_FILE="${SYSTEMD_DIR}/${SERVICE}"

PS4_IP_FILE="${STATE_DIR}/ps4.ip"
PS4_MAC_FILE="${STATE_DIR}/ps4.mac"
LOG_FILE="${STATE_DIR}/ron1n.log"
PKG_LOG="${STATE_DIR}/packages.log"

mkdir -p "$DATA_DIR" "$STATE_DIR" "$CONFIG_DIR" "$SYSTEMD_DIR"

BOLD='\033[1m'
DIM='\033[2m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
RESET='\033[0m'

say()  { printf "%b\n" "$*"; }
info() { say "${BLUE}[+]${RESET} $*"; }
ok()   { say "${GREEN}[✓]${RESET} $*"; }
warn() { say "${YELLOW}[!]${RESET} $*"; }
err()  { say "${RED}[x]${RESET} $*" >&2; }
die()  { err "$*"; exit 1; }

banner() {
    printf "\n"
    say "${MAGENTA}${BOLD}╭──────────────────────────────────────────────╮${RESET}"
    say "${MAGENTA}${BOLD}│                    ron1n                     │${RESET}"
    say "${MAGENTA}${BOLD}│      PS4 9.00 Local Jailbreak Host          │${RESET}"
    say "${MAGENTA}${BOLD}╰──────────────────────────────────────────────╯${RESET}"
    say "${DIM}Built by 0xb0rn3 / Stingray Labs · v${RON1N_VERSION}${RESET}"
    printf "\n"
}

log() {
    printf '[%(%F %T)T] %s\n' -1 "$*" >> "$LOG_FILE"
}

have() { command -v "$1" >/dev/null 2>&1; }

install_dependencies() {
    local pkgs=(git python iproute2 iputils curl nmap arp-scan)

    info "Setting up ron1n..."
    sudo -v

    if sudo pacman -S --needed --noconfirm "${pkgs[@]}" >"$PKG_LOG" 2>&1; then
        ok "System dependencies ready."
    else
        err "Dependency setup failed."
        warn "pacman output:"
        cat "$PKG_LOG" >&2
        exit 1
    fi
}

detect_network() {
    IFACE="$(
        ip -4 route show default 2>/dev/null |
        awk 'NR==1 {
            for (i=1; i<=NF; i++) {
                if ($i=="dev") { print $(i+1); exit }
            }
        }'
    )"
    [[ -n "${IFACE:-}" ]] || die "Could not determine active IPv4 interface."

    LAN_IP="$(
        ip -4 addr show dev "$IFACE" 2>/dev/null |
        awk '/inet / {
            split($2,a,"/");
            print a[1];
            exit
        }'
    )"
    [[ -n "${LAN_IP:-}" ]] || die "No IPv4 address found on ${IFACE}."

    CIDR="$(
        ip -4 route show dev "$IFACE" 2>/dev/null |
        awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ && /scope link/ {
            print $1;
            exit
        }'
    )"
    [[ -n "${CIDR:-}" ]] || CIDR="$(ip -4 addr show dev "$IFACE" | awk '/inet / {print $2; exit}')"

    ok "Interface : ${IFACE}"
    ok "LAN IP    : ${LAN_IP}"
    ok "Network   : ${CIDR}"
}

# ----------------------------------------------------------------
# Legacy migration / port conflict handling
# ----------------------------------------------------------------

legacy_service_cleanup() {
    local legacy_services=(
        "ps4-900-host.service"
        "ps4-jailbreak-host.service"
    )

    local svc
    for svc in "${legacy_services[@]}"; do
        if systemctl --user cat "$svc" >/dev/null 2>&1; then
            warn "Legacy host detected: ${svc}"
            info "Migrating it to ron1n..."
            systemctl --user disable --now "$svc" >/dev/null 2>&1 || true
            ok "Disabled legacy service: ${svc}"
        fi
    done

    systemctl --user daemon-reload
}

port_owner() {
    ss -ltnp 2>/dev/null |
        awk -v p=":${PORT}" '$4 ~ p"$" {print; exit}'
}

ensure_port_available() {
    local owner
    owner="$(port_owner || true)"

    if [[ -z "$owner" ]]; then
        return 0
    fi

    # If ron1n itself owns the port, that is fine.
    if systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; then
        return 0
    fi

    err "TCP port ${PORT} is already in use."
    say "${DIM}${owner}${RESET}"
    printf "\n"
    warn "ron1n will not kill an unrelated process automatically."
    say "Check it with:"
    say "  ${CYAN}ss -ltnp | grep ':${PORT}'${RESET}"
    return 1
}

# ----------------------------------------------------------------
# PSFree host
# ----------------------------------------------------------------

validate_host() {
    local required=(index.html cache.html psfree.mjs lapse.mjs psfree_lapse.cache goldhen.bin)
    local missing=0

    for file in "${required[@]}"; do
        if [[ -f "${HOST_DIR}/${file}" ]]; then
            ok "$file"
        else
            err "Missing upstream host file: $file"
            missing=1
        fi
    done

    (( missing == 0 )) || die "Upstream PSFree/Lapse tree is incomplete."
}

install_host() {
    if [[ -d "${HOST_DIR}/.git" ]]; then
        info "Checking PSFree/Lapse host..."
        if git -C "$HOST_DIR" pull --ff-only >/dev/null 2>&1; then
            ok "PSFree/Lapse host is up to date."
        else
            warn "Could not update upstream; using existing local copy."
        fi
    else
        info "Fetching PSFree/Lapse host..."
        rm -rf "$HOST_DIR"
        git clone --depth=1 "$REPO_URL" "$HOST_DIR" >/dev/null 2>&1 ||
            die "Failed to clone the PSFree/Lapse host."
        ok "PSFree/Lapse downloaded."
    fi

    validate_host
}

# ----------------------------------------------------------------
# systemd
# ----------------------------------------------------------------

write_service() {
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=ron1n - PS4 9.00 Local Jailbreak Web Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HOST_DIR}
ExecStart=/usr/bin/python -m http.server ${PORT} --bind 0.0.0.0 --directory ${HOST_DIR}
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
    systemctl --user enable "$SERVICE" >/dev/null 2>&1 || true
    sudo loginctl enable-linger "$USER" >/dev/null 2>&1 || true
}

start_service() {
    legacy_service_cleanup

    # Stop our own stale instance before checking the port.
    systemctl --user stop "$SERVICE" >/dev/null 2>&1 || true
    sleep 0.3

    if ! ensure_port_available; then
        die "Cannot start the local host until TCP/${PORT} is free."
    fi

    info "Starting ron1n host..."

    if ! systemctl --user start "$SERVICE"; then
        service_failure_report
        exit 1
    fi

    sleep 1

    if ! systemctl --user is-active --quiet "$SERVICE"; then
        service_failure_report
        exit 1
    fi

    ok "ron1n host service is running."
}

service_failure_report() {
    printf "\n"
    err "ron1n web service failed to start."
    say "${BOLD}Systemd says:${RESET}"
    printf "\n"

    journalctl --user -u "$SERVICE" -n 15 --no-pager 2>/dev/null |
        sed 's/^/  /' || true

    printf "\n"

    local owner
    owner="$(port_owner || true)"
    if [[ -n "$owner" ]]; then
        warn "Port ${PORT} currently has a listener:"
        say "  ${owner}"
    fi
}

configure_firewall() {
    if have firewall-cmd; then
        info "Configuring local firewall..."
        sudo firewall-cmd --permanent --add-port="${PORT}/tcp" >/dev/null 2>&1 || true
        sudo firewall-cmd --reload >/dev/null 2>&1 || true
        ok "TCP ${PORT} available on the LAN."
    elif have ufw; then
        info "Configuring local firewall..."
        sudo ufw allow "${PORT}/tcp" >/dev/null 2>&1 || true
        ok "TCP ${PORT} available on the LAN."
    fi
}

health_check() {
    if curl --silent --fail "http://127.0.0.1:${PORT}/" >/dev/null; then
        ok "Web host health check passed."
    else
        service_failure_report
        die "Local HTTP health check failed."
    fi
}

# ----------------------------------------------------------------
# PS4 detection
# ----------------------------------------------------------------

normalize_mac() { tr '[:upper:]' '[:lower:]'; }

arp_scan_raw() {
    sudo arp-scan --interface="$IFACE" --localnet 2>/dev/null || true
}

saved_ps4_online() {
    [[ -s "$PS4_IP_FILE" ]] || return 1
    local ip
    ip="$(<"$PS4_IP_FILE")"

    if ping -c1 -W1 "$ip" >/dev/null 2>&1; then
        printf '%s\n' "$ip"
        return 0
    fi
    return 1
}

discover_by_saved_mac() {
    [[ -s "$PS4_MAC_FILE" ]] || return 1

    local wanted
    wanted="$(<"$PS4_MAC_FILE")"
    wanted="$(printf '%s' "$wanted" | normalize_mac)"

    arp_scan_raw |
    awk -v wanted="$wanted" '
        /^[0-9]+\./ {
            mac=tolower($2)
            if (mac == wanted) {
                print $1 "\t" $2
                exit
            }
        }
    '
}

discover_sony_candidates() {
    arp_scan_raw |
    awk '
        /^[0-9]+\./ {
            line=tolower($0)
            if (line ~ /sony/ || line ~ /playstation/) {
                print $1 "\t" $2 "\t" substr($0,index($0,$3))
            }
        }
    '
}

discover_ps4_once() {
    detect_network >/dev/null

    local hit ip mac

    if hit="$(saved_ps4_online 2>/dev/null)" && [[ -n "$hit" ]]; then
        ip="$hit"
        mac="$(ip neigh show "$ip" 2>/dev/null | awk '/lladdr/ {print $5; exit}')"
        [[ -n "$mac" ]] && printf '%s\n' "$mac" > "$PS4_MAC_FILE"
        printf '%s\n' "$ip"
        return 0
    fi

    hit="$(discover_by_saved_mac | head -n1 || true)"
    if [[ -n "$hit" ]]; then
        ip="$(awk '{print $1}' <<<"$hit")"
        mac="$(awk '{print $2}' <<<"$hit")"
        printf '%s\n' "$ip" > "$PS4_IP_FILE"
        printf '%s\n' "$mac" | normalize_mac > "$PS4_MAC_FILE"
        printf '%s\n' "$ip"
        return 0
    fi

    hit="$(discover_sony_candidates | head -n1 || true)"
    if [[ -n "$hit" ]]; then
        ip="$(awk '{print $1}' <<<"$hit")"
        mac="$(awk '{print $2}' <<<"$hit")"
        printf '%s\n' "$ip" > "$PS4_IP_FILE"
        printf '%s\n' "$mac" | normalize_mac > "$PS4_MAC_FILE"
        printf '%s\n' "$ip"
        return 0
    fi

    return 1
}

ps4_connection_help() {
    detect_network >/dev/null

    printf "\n"
    say "${CYAN}${BOLD}Connect the PS4 to ron1n${RESET}"
    printf "\n"
    say "  ${BOLD}PS4 → Settings → Network → Set Up Internet Connection${RESET}"
    say "  • Choose ${BOLD}Use Wi-Fi${RESET} or ${BOLD}Use a LAN Cable${RESET}"
    say "  • Connect it to the same router/LAN as this machine"
    say "  • Choose ${BOLD}Easy${RESET}"
    say "  • Leave the console powered on"
    printf "\n"
    say "  Arch host : ${CYAN}${LAN_IP}:${PORT}${RESET}"
    say "  Interface : ${IFACE}"
    say "  Network   : ${CIDR}"
    printf "\n"
}

wait_for_ps4() {
    detect_network

    info "Looking for PS4..."

    local ip=""
    if ip="$(discover_ps4_once 2>/dev/null)" && [[ -n "$ip" ]]; then
        ok "PS4 detected at ${ip}"
        show_urls "$ip"
        return 0
    fi

    warn "PS4 is not visible yet."
    ps4_connection_help
    say "${YELLOW}ron1n will keep waiting.${RESET}"
    say "${DIM}Scanning every ${SCAN_INTERVAL}s · Ctrl+C to stop.${RESET}"
    printf "\n"

    local ticks=0
    while true; do
        if ip="$(discover_ps4_once 2>/dev/null)" && [[ -n "$ip" ]]; then
            printf "\r\033[K"
            ok "PS4 detected at ${ip}"
            show_urls "$ip"
            return 0
        fi

        ticks=$((ticks + 1))
        case $((ticks % 4)) in
            0) dots="" ;;
            1) dots="." ;;
            2) dots=".." ;;
            3) dots="..." ;;
        esac
        printf "\r${YELLOW}[~]${RESET} Waiting for PS4${dots}   "
        sleep "$SCAN_INTERVAL"
    done
}

# ----------------------------------------------------------------
# UI
# ----------------------------------------------------------------

show_urls() {
    local ps4_ip="${1:-}"
    detect_network >/dev/null

    printf "\n"
    say "${GREEN}${BOLD}ron1n is ready.${RESET}"
    say "Host          : ${CYAN}http://${LAN_IP}:${PORT}/${RESET}"
    say "Offline cache : ${CYAN}http://${LAN_IP}:${PORT}/cache.html${RESET}"
    [[ -n "$ps4_ip" ]] && say "PS4           : ${GREEN}${ps4_ip}${RESET}"

    printf "\n"
    say "${BOLD}On the PS4:${RESET}"
    say "  1. Open Internet Browser."
    say "  2. Visit ${CYAN}http://${LAN_IP}:${PORT}/cache.html${RESET}"
    say "  3. Let caching finish."
    say "  4. Visit ${CYAN}http://${LAN_IP}:${PORT}/${RESET}"
    say "  5. OPTIONS → Add Bookmark → name it ${BOLD}★ Jailbreak${RESET}"
    printf "\n"
    warn "Reserve ${LAN_IP} for this Arch machine in DHCP so the bookmark stays valid."
}

scan_cmd() {
    banner
    detect_network
    info "Scanning ${CIDR}..."

    local rows
    rows="$(discover_sony_candidates || true)"

    if [[ -z "$rows" ]]; then
        warn "No Sony/PlayStation device found."
        return 0
    fi

    printf "\n%-16s %-18s %s\n" "IP" "MAC" "VENDOR"
    printf "%-16s %-18s %s\n" "----------------" "-----------------" "------------------------"

    while IFS=$'\t' read -r ip mac vendor; do
        printf "%-16s %-18s %s\n" "$ip" "$mac" "$vendor"
    done <<<"$rows"
}

install_cmd() {
    banner
    install_dependencies
    printf "\n"

    detect_network
    printf "\n"

    install_host
    printf "\n"

    write_service
    configure_firewall
    start_service
    health_check
    printf "\n"

    wait_for_ps4
}

status_cmd() {
    banner
    detect_network
    printf "\n"

    if systemctl --user is-active --quiet "$SERVICE"; then
        ok "ron1n.service is running."
    else
        warn "ron1n.service is not running."
        service_failure_report
    fi

    local ip=""
    if ip="$(discover_ps4_once 2>/dev/null)" && [[ -n "$ip" ]]; then
        ok "PS4 online: ${ip}"
    else
        warn "PS4 not detected."
    fi

    show_urls "$ip"
}

help_cmd() {
    banner
    cat <<EOF
Usage:
  ./ron1n install
  ./ron1n wait
  ./ron1n scan
  ./ron1n connect
  ./ron1n status
  ./ron1n restart
  ./ron1n logs
  ./ron1n update

Environment:
  RON1N_PORT=8080
  RON1N_SCAN_INTERVAL=5
EOF
}

case "${1:-install}" in
    install)
        install_cmd
        ;;
    wait)
        banner
        wait_for_ps4
        ;;
    scan)
        scan_cmd
        ;;
    connect)
        banner
        detect_network
        ps4_connection_help
        ;;
    status)
        status_cmd
        ;;
    restart)
        banner
        write_service
        start_service
        health_check
        show_urls
        ;;
    logs)
        journalctl --user -u "$SERVICE" -f
        ;;
    update)
        banner
        install_host
        write_service
        start_service
        health_check
        show_urls
        ;;
    help|-h|--help)
        help_cmd
        ;;
    *)
        err "Unknown command: $1"
        help_cmd
        exit 2
        ;;
esac
